{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/abhinav10905/resume-json-generator/main/resume.schema.json",
  "title": "resume.json",
  "description": "Structured resume data generated by the resume.json builder. Optional fields that are left blank in the form are omitted from the output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personal",
    "summary",
    "education",
    "skills",
    "experience",
    "projects",
    "certifications",
    "achievements",
    "positions"
  ],
  "properties": {
    "personal": {
      "type": "object",
      "description": "Contact and identity details.",
      "additionalProperties": false,
      "required": ["fullName", "email"],
      "properties": {
        "fullName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^0-9]*$",
          "description": "Full name. Must not contain digits.",
          "examples": ["Alex Morgan"]
        },
        "email": {
          "type": "string",
          "format": "email",
          "examples": ["alex@example.com"]
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[0-9]{1,4} .+$",
          "description": "Country dial code followed by the local number, e.g. \"+91 98765 43210\". The total number of digits (dial code + number) is at most 15.",
          "examples": ["+91 98765 43210"]
        },
        "location": {
          "type": "string",
          "examples": ["Bhopal, India"]
        },
        "linkedin": {
          "type": "string",
          "format": "uri",
          "examples": ["https://linkedin.com/in/alex"]
        },
        "github": {
          "type": "string",
          "format": "uri",
          "examples": ["https://github.com/alex"]
        },
        "portfolio": {
          "type": "string",
          "format": "uri",
          "examples": ["https://alex.dev"]
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "Professional summary. Empty string when not provided."
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/education" }
    },
    "skills": {
      "type": "array",
      "description": "Individual skills, split from the comma-separated input and trimmed.",
      "items": { "type": "string", "minLength": 1 },
      "examples": [["JavaScript", "React", "SQL"]]
    },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/experience" }
    },
    "projects": {
      "type": "array",
      "items": { "$ref": "#/$defs/project" }
    },
    "certifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/certification" }
    },
    "achievements": {
      "type": "array",
      "items": { "$ref": "#/$defs/achievement" }
    },
    "positions": {
      "type": "array",
      "description": "Positions and leadership roles.",
      "items": { "$ref": "#/$defs/position" }
    }
  },
  "$defs": {
    "education": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "institution": { "type": "string", "minLength": 1 },
        "degree": { "type": "string", "minLength": 1, "examples": ["B.Tech"] },
        "field": { "type": "string", "minLength": 1, "examples": ["Computer Science"] },
        "startDate": { "type": "string", "minLength": 1, "examples": ["2023"] },
        "endDate": { "type": "string", "minLength": 1, "examples": ["2027", "Present"] },
        "grade": { "type": "string", "minLength": 1, "examples": ["9.2 CGPA"] }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1, "examples": ["Software Developer Intern"] },
        "company": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "minLength": 1, "examples": ["Jun 2026"] },
        "endDate": { "type": "string", "minLength": 1, "examples": ["Present"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "technologies": {
          "type": "string",
          "minLength": 1,
          "description": "Free-text, comma-separated list of technologies.",
          "examples": ["React, Node.js, MongoDB"]
        },
        "url": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1, "examples": ["Oct 2026"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "achievement": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1, "examples": ["2026"] }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": { "type": "string", "minLength": 1, "examples": ["Class Representative"] },
        "organization": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "minLength": 1, "examples": ["2025"] },
        "endDate": { "type": "string", "minLength": 1, "examples": ["Present"] },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
